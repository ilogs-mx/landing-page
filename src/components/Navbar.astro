---
import { socialLinks } from "../utils/contants";
---

<nav
  class="fixed top-0 bg-primary z-50 w-full h-16 shadow-md"
>
  <div class="mx-auto max-w-6xl px-5 md:px-8 h-full flex justify-between items-center">
  <img
    src="/image/logo.webp"
    alt="Ilogs"
    class="icon w-12 h-12 md:w-20 md:h-20"
  />

  <div class="flex flex-row p-3 gap-3 items-center">
    {socialLinks.map(({ name, href, icon: Icon, iconClass }) => (
      <a
        href={href}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={name}
        class={`icon fill-light ${iconClass ?? ""}`}
      >
        <Icon />
      </a>
    ))}
  </div>
  </div>
</nav>
<script>
  import { gsap } from "gsap";

  gsap.from(".icon", {
    y: -100,
    stagger: 0.25,
    duration: 0.3,
  });
</script>
