---
import Section from "../ui/Section.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import WhatsAppButton from "../ui/WhatsAppButton.astro";
import { painPoints } from "../../utils/constains";
---

<Section id="problema" class="py-20 md:py-28 problem">
  <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-center">
    <div>
      <SectionHeading
        align="left"
        eyebrow="El problema"
        title="La salida de tus alumnos no debería ser el momento más estresante del día."
        intro="Cada tarde, la puerta de la escuela se llena de listas manuales, llamadas y dudas: ¿está autorizado? ¿lo puede llevar el abuelo? Sin un proceso claro, la seguridad de los niños depende de la memoria del personal."
      />
      <div class="mt-8">
        <WhatsAppButton
          label="Quiero resolverlo en mi escuela"
          message="¡Hola! Tengo el problema de salidas desordenadas en mi escuela y quiero conocer iLogs."
        />
      </div>
    </div>

    <div class="grid gap-4">
      {
        painPoints.map((point) => (
          <div class="problem-card flex items-start gap-4 rounded-2xl border border-primary/15 bg-light/60 p-5 md:p-6">
            <span class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-primary/10 shrink-0">
              <point.icon class="fill-primary w-7 h-7" />
            </span>
            <div>
              <h3 class="font-brand text-base md:text-lg text-foreground">
                {point.title}
              </h3>
              <p class="mt-1 text-sm md:text-base text-foreground/70">
                {point.description}
              </p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</Section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  gsap.from(".problem-card", {
    opacity: 0,
    y: 30,
    duration: 0.5,
    stagger: 0.15,
    scrollTrigger: {
      trigger: ".problem",
      start: "top 70%",
    },
  });
</script>