---
interface Props {
  title: string;
  subtitle: string;
  icon?: any;
  class?: string;
}

const { title, subtitle, icon: Icon, class: className = "" } = Astro.props;
---

<div
  class:list={[
    "flex flex-col gap-4 rounded-3xl border border-primary/15 bg-light/70 p-6 md:p-8 transition-all duration-200 hover:border-primary/40 hover:shadow-md",
    className,
  ]}
>
  {
    Icon && (
      <span class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-primary/10">
        <Icon class="fill-primary w-8 h-8" />
      </span>
    )
  }
  <h3 class="font-brand text-lg md:text-xl text-foreground">{title}</h3>
  <p class="text-sm md:text-base text-foreground/70 leading-relaxed">
    {subtitle}
  </p>
</div>