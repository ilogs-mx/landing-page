---
interface Props {
  number: string;
  title: string;
  description: string;
  class?: string;
}

const { number, title, description, class: className = "" } = Astro.props;
---

<div
  class:list={[
    "relative rounded-3xl border border-primary/20 bg-light/60 p-6 md:p-8 transition-shadow hover:shadow-lg",
    className,
  ]}
>
  <span
    class="flex items-center justify-center w-12 h-12 rounded-full bg-primary text-light font-brand text-lg shrink-0"
  >
    {number}
  </span>
  <h3 class="mt-5 font-brand text-xl md:text-2xl text-foreground">{title}</h3>
  <p class="mt-3 text-base md:text-lg text-foreground/70 leading-relaxed">
    {description}
  </p>
</div>