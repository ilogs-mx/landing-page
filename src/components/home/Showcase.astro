---
import Section from "../ui/Section.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import Play from "../../assets/svg/play.svg";

const videoId = "PCoODwGT980";
const title = "Presentación de iLogs";
const thumbnail = "/image/banner-ilogs.webp";
---

<Section id="producto" class="py-20 md:py-28 showcase">
  <SectionHeading
    eyebrow="Míralo en acción"
    title="Conoce iLogs en menos de 2 minutos."
    intro="Una vista rápida de cómo se ve una salida escolar digitalizada de principio a fin."
  />

  <div
    class="showcase-player mt-12 flex aspect-video max-w-4xl mx-auto w-full rounded-2xl overflow-hidden relative cursor-pointer shadow-lg"
    onclick={`this.outerHTML = '<iframe class="w-full h-full aspect-video rounded-2xl" src="https://www.youtube.com/embed/${videoId}?autoplay=1" title="${title}" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>'`}
  >
    <img
      src={thumbnail}
      alt={`Vista previa de ${title}`}
      class="w-full h-full object-cover transition-transform duration-300 hover:scale-105"
      loading="lazy"
    />
    <div class="absolute inset-0 flex items-center justify-center bg-dark/20">
      <div
        class="flex items-center justify-center w-20 h-20 md:w-28 md:h-28 rounded-full bg-primary/90 text-light hover:scale-110 transition-transform duration-300"
      >
        <Play class="w-8 h-8 md:w-12 md:h-12 fill-light" />
      </div>
    </div>
  </div>
</Section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  gsap.from(".showcase-player", {
    opacity: 0,
    y: 40,
    duration: 0.7,
    scrollTrigger: {
      trigger: ".showcase",
      start: "top 70%",
    },
  });
</script>