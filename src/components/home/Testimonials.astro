---
import Section from "../ui/Section.astro";
import Watermark from "../ui/Watermark.astro";
import VideoPlayer from "../ui/VideoPlayer.astro";

/*
 * Sección "Testimonio".
 * Va inmediatamente debajo de "Proceso de entrega" (HowItWorks).
 *
 * Se muestran dos testimonios (docente / padre) y el usuario cambia entre
 * ellos con dos botones. El docente es el principal por defecto.
 *
 * Decisión de diseño: se renderizan ambos paneles en el DOM y se conmuta su
 * visibilidad con la clase `hidden`. Así evitamos inyectar/quitar el iframe
 * manualmente y aprovechamos la lógica existente de VideoPlayer (iframe apagado
 * hasta el click en play). Al ocultar un panel, reseteamos su iframe para
 * detener la reproducción si estaba activa.
 *
 * Datos explícitos (sin colección de contenido) para mantener bajo acoplamiento
 * y porque el contenido aprobado es fijo y breve.
 */
const testimonials = [
  {
    key: "docente",
    label: "Ver testimonio docente",
    videoId: "EpjcOyA5TZM",
    videoTitle: "Como maestro, ¡esto cambió todo en mi escuela!",
    thumbnail: "/image/banner-video1.webp",
    title: "Como maestro, ¡esto cambió todo en mi escuela!",
    summary:
      "Este video presenta iLogs como una herramienta que transforma la gestión de salidas escolares con más seguridad, control en tiempo real, registros digitales y tranquilidad para toda la comunidad escolar.",
  },
  {
    key: "padre",
    label: "Ver testimonio padre",
    videoId: "Lq045r47V3M",
    videoTitle: "¡Así cambió mi manera de recoger a mi hijo con iLogs!",
    thumbnail: "/image/banner-video2.webp",
    title: "¡Así cambió mi manera de recoger a mi hijo con iLogs!",
    summary:
      "Una madre comparte cómo iLogs agiliza la recogida, facilita permisos y mejora la comunicación con la escuela para una salida más segura.",
  },
];
---

<Section id="testimonio" class="py-20 md:py-28 testimonials-section relative overflow-hidden">
  {
    /* Marcas de agua decorativas (Tabler) sobre fondo claro: text-primary/30,
       detrás del contenido (z-0 vs. selector/paneles z-10). "quote" alude al
       testimonio y "message-heart" al carácter humano; quedan en esquinas
       opuestas para no competir con el video centrado. */
  }
  <div class="absolute inset-0 pointer-events-none z-0" aria-hidden="true">
    <Watermark
      name="tabler:quote"
      tone="primary"
      class="absolute top-8 left-2 md:top-12 md:left-8 w-28 h-28 md:w-36 md:h-36 -rotate-12"
    />
  </div>

  {
    /* Encabezado: acento con gradiente en parte del subtítulo,
       mismo patrón que HowItWorks. */
  }
  <div class="max-w-3xl text-center mx-auto relative z-10">
    <span
      class="block text-xs md:text-sm font-bold uppercase tracking-[0.2em] mb-3 text-primary"
    >
      Testimonios
    </span>
    <h2
      class="font-brand text-3xl md:text-4xl lg:text-5xl leading-tight text-foreground"
    >
      <span class="text-gradient-accent">Historias reales</span>{" "}de
      tranquilidad
    </h2>
    <p class="mt-4 text-base md:text-lg leading-relaxed text-foreground">
      Escuela y familia comparten cómo iLogs hace cada entrega más segura y
      confiable.
    </p>
  </div>

  {
    /* Selector de testimonios. role=group para accesibilidad;
       cada botón expone su estado con aria-pressed. */
  }
  <div
    class="mt-10 flex flex-wrap justify-center gap-3 relative z-10"
    role="group"
    aria-label="Selecciona un testimonio"
  >
    {
      testimonials.map((t, i) => (
        <button
          type="button"
          class:list={[
            "testimonials-tab px-5 py-2.5 rounded-full border font-semibold text-sm md:text-base transition focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-accent-amber/60 cursor-pointer",
            i === 0
              ? "is-active border-primary bg-primary text-light shadow"
              : "border-primary/30 bg-light text-foreground hover:border-primary/60",
          ]}
          data-target={t.key}
          aria-pressed={i === 0 ? "true" : "false"}
        >
          {t.label}
        </button>
      ))
    }
  </div>

  {/* Paneles: uno por testimonio. Solo el primero visible al cargar. */}
  <div class="mt-10 relative z-10">
    {
      testimonials.map((t, i) => (
        <div
          class:list={["testimonials-panel", i === 0 ? "" : "hidden"]}
          data-key={t.key}
          role="tabpanel"
        >
          <VideoPlayer
            videoId={t.videoId}
            videoTitle={t.videoTitle}
            thumbnail={t.thumbnail}
          />
          <div class="mt-6 max-w-3xl mx-auto text-center">
            <h3 class="font-brand text-xl md:text-2xl text-primary">
              {t.title}
            </h3>
            <p class="mt-3 text-base md:text-lg leading-relaxed text-foreground">
              {t.summary}
            </p>
          </div>
        </div>
      ))
    }
  </div>
</Section>

<script>
  // Conmuta entre testimonios: actualiza visibilidad de paneles y estado de
  // los botones. Al ocultar un panel, detiene su video (si estaba reproduciendo)
  // para que no suene en background.
  function initTestimonialsTabs() {
    const section = document.querySelector<HTMLElement>(
      ".testimonials-section",
    );
    if (!section || section.dataset.init) return;
    section.dataset.init = "true";

    const tabs = Array.from(
      section.querySelectorAll<HTMLButtonElement>(".testimonials-tab"),
    );
    const panels = Array.from(
      section.querySelectorAll<HTMLElement>(".testimonials-panel"),
    );

    const ACTIVE_CLASSES = [
      "is-active",
      "border-primary",
      "bg-primary",
      "text-light",
      "shadow",
    ];
    const INACTIVE_CLASSES = [
      "border-primary/30",
      "bg-light",
      "text-foreground",
    ];

    function activate(target: string) {
      panels.forEach((panel) => {
        const isActive = panel.dataset.key === target;
        panel.classList.toggle("hidden", !isActive);
        if (!isActive) {
          // Detenemos el iframe del panel oculto.
          const iframe = panel.querySelector<HTMLIFrameElement>(
            "iframe.video-player__iframe",
          );
          if (iframe) iframe.src = "";
          const player = panel.querySelector<HTMLElement>(".video-player");
          player?.classList.remove("is-playing");
          const playBtn = panel.querySelector<HTMLButtonElement>(
            ".video-player__play",
          );
          playBtn?.classList.remove("hidden");
        }
      });
      tabs.forEach((tab) => {
        const active = tab.dataset.target === target;
        tab.setAttribute("aria-pressed", String(active));
        ACTIVE_CLASSES.forEach((c) => tab.classList.toggle(c, active));
        INACTIVE_CLASSES.forEach((c) => tab.classList.toggle(c, !active));
      });
    }

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => activate(tab.dataset.target!));
    });
  }

  initTestimonialsTabs();
  document.addEventListener("astro:after-swap", initTestimonialsTabs);
</script>
