---
import Section from "../ui/Section.astro";
import VideoPlayer from "../ui/VideoPlayer.astro";
import { Icon } from "astro-icon/components";

const videoId = "PCoODwGT980";
const videoTitle = "Presentación de iLogs";
const thumbnail = "/image/banner-ilogs.webp";
---

{
  /*
  Sección "Proceso de entrega".
  El encabezado se inlinea (en vez de usar SectionHeading) para poder acentuar
  con gradiente una parte del subtítulo. Cada paso vive como markup explícito
  (sin data-driven ni StepCard) para que el gráfico por paso sea claro de leer.
*/
}

<Section id="proceso-de-entrega" class="py-20 md:py-28 bg-light/50 how">
  <div class="max-w-3xl text-center mx-auto">
    <span
      class="block text-xs md:text-sm font-bold uppercase tracking-[0.2em] mb-3 text-primary"
    >
      Proceso de entrega
    </span>
    <h2
      class="font-brand text-3xl md:text-4xl lg:text-5xl leading-tight text-foreground"
    >
      Entregas, <span class="text-gradient-accent">simples y confiables</span>
    </h2>
    <p class="mt-4 text-base md:text-lg leading-relaxed text-foreground">
      Un proceso simple de 3 pasos para autorizar, validar y confirmar cada
      entrega con seguridad.
    </p>
  </div>

  <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {
      /*
      Paso 1 — Genera: QR visible al centro.
      Animación: pulso ligero (escala sutil en loop).
    */
    }
    <article
      class="step relative rounded-3xl border border-primary/20 bg-light/60 p-6 md:p-8 transition-shadow hover:shadow-lg"
    >
      <div
        class="hiw-graphic flex items-center justify-center aspect-square rounded-2xl bg-gradient-to-br from-primary/10 to-primary/5"
        data-anim="pulse"
      >
        <Icon name="qr-code" size={120} class="hiw-qr text-foreground" />
      </div>
      <h3 class="mt-5 font-brand text-xl md:text-2xl text-primary">
        1. Genera
      </h3>
      <p class="mt-3 text-base md:text-lg text-foreground/70 leading-relaxed">
        El tutor crea un QR único con vigencia y autorización específicas.
      </p>
    </article>

    {
      /*
      Paso 2 — Escanea: lector móvil / scanner.
      Animación: barrido vertical de la línea de scan.
    */
    }
    <article
      class="step relative rounded-3xl border border-primary/20 bg-light/60 p-6 md:p-8 transition-shadow hover:shadow-lg"
    >
      <div
        class="hiw-graphic relative flex items-center justify-center aspect-square rounded-2xl bg-gradient-to-br from-primary/10 to-primary/5 overflow-hidden"
        data-anim="scan"
      >
        <Icon name="qr-scan" size={150} class="hiw-qr text-foreground" />

        {/* Línea de scan animada */}
        <span
          class="hiw-scanline absolute left-4 right-4 h-[3px] rounded-full bg-gradient-to-r from-transparent via-accent-amber to-transparent"
          aria-hidden="true"
        >
        </span>
      </div>

      <h3 class="mt-5 font-brand text-xl md:text-2xl text-primary">
        2. Escanea
      </h3>
      <p class="mt-3 text-base md:text-lg text-foreground/70 leading-relaxed">
        El personal valida la información al instante.
      </p>
    </article>

    {
      /*
      Paso 3 — Confirma: campana / notificación.
      Animación: aparición / escala suave en loop.
    */
    }
    <article
      class="step relative rounded-3xl border border-primary/20 bg-light/60 p-6 md:p-8 transition-shadow hover:shadow-lg"
    >
      <div
        class="hiw-graphic flex items-center justify-center aspect-square rounded-2xl bg-gradient-to-br from-primary/10 to-primary/5"
        data-anim="bell"
      >
        <Icon name="bell" size={120} class="hiw-bell text-foreground" />
      </div>

      <h3 class="mt-5 font-brand text-xl md:text-2xl text-primary">
        3. Confirma
      </h3>
      <p class="mt-3 text-base md:text-lg text-foreground/70 leading-relaxed">
        La entrega se registra y se notifica a los tutores al instante.
      </p>
    </article>
  </div>

  {
    /*
    Video de presentación debajo de los 3 pasos.
    Componente reutilizable (VideoPlayer) con fachada de miniatura;
    el iframe de YouTube solo se carga al hacer click en play.
    */
  }
  <div class="mt-12 md:mt-16">
    <VideoPlayer
      videoId={videoId}
      videoTitle={videoTitle}
      thumbnail={thumbnail}
      caption="Conoce iLogs en menos de 2 minutos."
    />
  </div>
</Section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  // Solo animamos cuando el usuario no pide movimiento reducido.
  const mm = gsap.matchMedia();

  mm.add("(prefers-reduced-motion: no-preference)", () => {
    // Entrada por scroll de las tarjetas.
    gsap.from(".how .step", {
      opacity: 0,
      y: 30,
      duration: 0.5,
      stagger: 0.12,
      scrollTrigger: {
        trigger: ".how",
        start: "top 70%",
      },
    });

    // Microanimaciones en loop por paso, con delays en cascada.
    // Pulso del QR (paso 1).
    gsap.to('.how [data-anim="pulse"] .hiw-qr', {
      scale: 1.06,
      duration: 1.4,
      ease: "sine.inOut",
      yoyo: true,
      repeat: -1,
    });

    // Barrido del lector (paso 2).
    gsap.fromTo(
      '.how [data-anim="scan"] .hiw-scanline',
      { top: "20%" },
      {
        top: "78%",
        duration: 1.8,
        ease: "sine.inOut",
        yoyo: true,
        repeat: -1,
      },
    );

    // Sacudida / notificación de la campana (paso 3).
    // Pivote superior para que parezca colgada; rotación sutil con pausa entre repeticiones.
    gsap.set('.how [data-anim="bell"] .hiw-bell', {
      transformOrigin: "top center",
    });

    const bellShake = gsap.timeline({
      repeat: -1,
      repeatDelay: 1.6,
      defaults: { ease: "sine.out" },
    });

    bellShake
      // Tire rápido a la derecha
      .fromTo(
        '.how [data-anim="bell"] .hiw-bell',
        { rotation: 0 },
        { rotation: 10, duration: 0.12 },
      )
      // Rebote a la izquierda
      .to('.how [data-anim="bell"] .hiw-bell', {
        rotation: -8,
        duration: 0.18,
        ease: "sine.inOut",
      })
      // Retorno amortiguado al centro
      .to('.how [data-anim="bell"] .hiw-bell', {
        rotation: 0,
        duration: 0.6,
        ease: "elastic.out(1.2, 0.4)",
      });
  });
</script>
