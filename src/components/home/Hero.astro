---
import WhatsAppButton from "../ui/WhatsAppButton.astro";
import Section from "../ui/Section.astro";
---

<section class="hero bg-primary relative overflow-hidden">
  <Section class="pt-24 md:pt-32 pb-14 md:pb-16">
    <div
      class="hero-text flex flex-col items-center lg:items-start text-center lg:text-left"
    >
      <span
        class="block text-xs md:text-sm font-bold uppercase tracking-[0.2em] mb-2 text-light/80"
      >
        ¿Quién recoge a cada alumno y cómo lo confirmas?
      </span>
      <h1
        class="font-brand text-3xl md:text-5xl lg:text-6xl text-light leading-tight max-w-4xl"
      >
        Digitaliza la salida escolar con un proceso ágil, verificable y
        confiable.
      </h1>
      <p
        class="mt-2 text-base md:text-lg text-light/85 max-w-2xl leading-relaxed"
      >
        Autoriza, valida y confirma cada entrega con QR dinámicos y
        notificaciones inmediatas.
      </p>

      <div
        class="mt-6 flex flex-col sm:flex-row gap-3 sm:gap-4 items-center sm:items-start"
      >
        <WhatsAppButton
          size="lg"
          message="¡Hola! Quiero agendar una demo de iLogs para mi escuela."
          label="Agendar demo por WhatsApp"
          variant="light"
        />
        <a
          href="#que-es"
          class="inline-flex items-center justify-center gap-2 rounded-2xl px-5 py-3 text-base md:text-lg font-semibold text-light/90 border border-light/40 hover:bg-light/10 hover:border-light/60 transition-colors w-full sm:w-auto"
        >
          Ver qué es iLogs
        </a>
      </div>
    </div>
  </Section>

  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 1440 160"
    class="block w-full relative z-0 h-[70px] sm:h-[80px] md:h-auto"
    aria-hidden="true"
    preserveAspectRatio="none"
  >
    <!-- Capa posterior: onda naranja fuerte que asoma por encima de la onda clara -->
    <path
      class="fill-primary"
      d="M0,160 L0,70 C180,140 360,10 540,60 C720,110 900,20 1080,62 C1260,98 1380,52 1440,46 L1440,160 Z"
    ></path>
    <!-- Capa frontal: onda clara que suaviza la transición al fondo de la página -->
    <path
      class="fill-background"
      d="M0,160 L0,112 C200,150 380,78 540,100 C720,122 900,74 1080,98 C1260,118 1380,86 1440,92 L1440,160 Z"
    ></path>
  </svg>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  gsap.from(".hero-text > *", {
    y: 24,
    opacity: 0,
    duration: 0.5,
    stagger: 0.08,
    ease: "power3.out",
  });

  gsap.from(".hero-image", {
    y: 60,
    opacity: 0,
    duration: 0.7,
    ease: "power3.out",
    delay: 0.2,
  });
</script>
