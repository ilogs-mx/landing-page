---
import WhatsAppButton from "../ui/WhatsAppButton.astro";
import Section from "../ui/Section.astro";
import Rule from "../../assets/svg/rule.svg";
import Rule2 from "../../assets/svg/rule2.svg";
import Pen from "../../assets/svg/pen.svg";
---

<section class="hero bg-primary relative overflow-hidden">
  <Section
    class="pt-24 md:pt-28 pb-24 md:pb-28"
    containerClass="grid lg:grid-cols-2 gap-8 lg:gap-12 items-center"
  >
    <div class="hero-text flex flex-col items-center lg:items-start text-center lg:text-left">
      <span
        class="block text-xs md:text-sm font-bold uppercase tracking-[0.25em] text-light/80 mb-4"
      >
        ¿Qué es iLogs?
      </span>
      <h1
        class="font-brand text-3xl md:text-5xl lg:text-6xl text-light leading-tight"
      >
        La app que digitaliza la salida de tus alumnos con QR.
      </h1>
      <p
        class="mt-4 text-base md:text-lg text-light/90 max-w-md leading-relaxed"
      >
        iLogs sustituye listas manuales y llamadas por un código QR dinámico de
        24 h: más seguridad para las familias y menos caos en la puerta de tu
        escuela.
      </p>

      <div class="mt-7 flex flex-col sm:flex-row gap-3 sm:gap-4 items-center sm:items-start">
        <WhatsAppButton
          size="lg"
          message="¡Hola! Quiero agendar una demo de iLogs para mi escuela."
          label="Agendar demo por WhatsApp"
          variant="light"
        />
        <a
          href="#que-es"
          class="inline-flex items-center justify-center gap-2 rounded-2xl px-5 py-3 text-base md:text-lg font-semibold text-light/90 border border-light/40 hover:bg-light/10 hover:border-light/60 transition-colors w-full sm:w-auto"
        >
          Ver qué es iLogs
        </a>
      </div>
    </div>

    <div class="relative flex justify-center lg:justify-end">
      <div class="hero-image relative w-52 md:w-72 lg:w-96">
        <img
          src="image/hero.png"
          alt="App iLogs en uso durante la salida escolar"
          class="w-full rotate-3 drop-shadow-2xl"
          loading="eager"
        />
      </div>
    </div>
  </Section>

  <Rule
    class="absolute z-10 w-20 lg:w-40 bottom-8 lg:bottom-24 left-0 -rotate-40 opacity-80"
  />
  <Rule2
    class="absolute z-10 w-20 lg:w-40 top-20 left-0 lg:left-6 rotate-80 opacity-80"
  />
  <Pen
    class="absolute z-10 w-16 lg:w-36 top-20 right-2 lg:right-6 -rotate-40 lg:rotate-45 opacity-80"
  />

  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 310" class="block w-full relative z-0">
    <path
      class="fill-background"
      d="M0,160L80,176C160,192,320,224,480,202.7C640,181,800,107,960,69.3C1120,32,1280,32,1360,32L1440,32L1440,320L1360,320C1280,320,1120,320,960,320C800,320,640,320,480,320C320,320,160,320,80,320L0,320Z"
    ></path>
  </svg>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  gsap.from(".hero-text > *", {
    y: 24,
    opacity: 0,
    duration: 0.5,
    stagger: 0.08,
    ease: "power3.out",
  });

  gsap.from(".hero-image", {
    y: 60,
    opacity: 0,
    duration: 0.7,
    ease: "power3.out",
    delay: 0.2,
  });
</script>